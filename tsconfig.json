// Editor / type-check only. Pi runs the .ts directly via jiti; nothing is emitted.
{
	"compilerOptions": {
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"target": "es2022",
		"lib": ["es2023"],
		"types": ["node"],
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true
	},
	"include": ["src/*.ts", "test/*.ts"]
}
